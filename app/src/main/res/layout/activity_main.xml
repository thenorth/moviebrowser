<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tv">

    <!-- Izgara tam ekran; ust padding kadar basligin ALTINDAN kayar -->
    <GridView
        android:id="@+id/site_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:drawSelectorOnTop="false"
        android:focusable="true"
        android:horizontalSpacing="14dp"
        android:listSelector="@android:color/transparent"
        android:numColumns="6"
        android:paddingLeft="38dp"
        android:paddingTop="86dp"
        android:paddingRight="38dp"
        android:paddingBottom="86dp"
        android:scrollbars="none"
        android:stretchMode="columnWidth"
        android:verticalSpacing="16dp" />

    <!-- Sabit baslik: opak bant + altinda yumusak gecis -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FA0A0F16"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="38dp"
            android:paddingTop="20dp"
            android:paddingRight="38dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand_first"
                android:textColor="@color/accent"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:letterSpacing="0.16"
                android:text="@string/brand_second"
                android:textColor="@color/text"
                android:textSize="23sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <View
                android:id="@+id/status_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/status_dot" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:textColor="@color/text"
                android:textSize="23sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:background="@drawable/header_fade" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/hint_scrim"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="26dp"
        android:paddingBottom="13dp">

        <TextView
            style="@style/KeyCap"
            android:text="@string/key_ok" />

        <TextView
            style="@style/KeyLabel"
            android:text="@string/key_ok_action" />

        <TextView
            style="@style/KeyCap"
            android:text="@string/key_menu" />

        <TextView
            style="@style/KeyLabel"
            android:text="@string/key_menu_action" />

        <TextView
            style="@style/KeyCap"
            android:text="@string/key_back" />

        <TextView
            style="@style/KeyLabel"
            android:text="@string/key_back_action" />
    </LinearLayout>

</FrameLayout>
