<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tv">

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="6dp"
        android:drawSelectorOnTop="false"
        android:focusable="true"
        android:listSelector="@drawable/row_selector"
        android:paddingLeft="38dp"
        android:paddingTop="86dp"
        android:paddingRight="38dp"
        android:paddingBottom="80dp"
        android:scrollbars="none" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/header_fade"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="38dp"
        android:paddingTop="18dp"
        android:paddingRight="38dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/tool_button_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:text="@string/back_button"
            android:textColor="@color/tool_button_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_weight="1"
            android:text="@string/status_title"
            android:textColor="@color/text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_test"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/tool_button_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:text="@string/status_test"
            android:textColor="@color/tool_button_text"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
