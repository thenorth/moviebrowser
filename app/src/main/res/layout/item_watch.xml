<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="58dp"
    android:background="@drawable/row_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="14dp"
    android:paddingRight="14dp">

    <TextView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/logo_tile"
        android:gravity="center"
        android:text="★"
        android:textColor="@color/accent"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/watch_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/watch_site"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_dim"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/watch_del"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:background="@drawable/tool_button_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:text="@string/remove"
        android:textColor="@color/tool_button_text"
        android:textSize="10sp"
        android:textStyle="bold" />

</LinearLayout>
