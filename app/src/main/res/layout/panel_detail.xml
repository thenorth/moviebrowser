<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tv"
    android:orientation="vertical"
    android:paddingLeft="38dp"
    android:paddingTop="26dp"
    android:paddingRight="38dp">

    <TextView
        android:id="@+id/detail_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text"
        android:textSize="24sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/detail_poster"
            android:layout_width="230dp"
            android:layout_height="330dp"
            android:background="#1A2230"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/detail_site"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/detail_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/detail_hint"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/detail_watch"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/tool_button_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="28dp"
                android:paddingRight="28dp"
                android:text="@string/watch_now"
                android:textColor="@color/tool_button_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detail_add"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/tool_button_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="28dp"
                android:paddingRight="28dp"
                android:text="@string/add_watch"
                android:textColor="@color/tool_button_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
