<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tv">

    <!-- Izgara tam ekran; ust padding kadar basligin ALTINDAN kayar -->
    <GridView
        android:id="@+id/site_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:drawSelectorOnTop="false"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:horizontalSpacing="14dp"
        android:listSelector="@android:color/transparent"
        android:numColumns="5"
        android:paddingLeft="262dp"
        android:paddingTop="86dp"
        android:paddingRight="38dp"
        android:paddingBottom="86dp"
        android:scrollbars="none"
        android:stretchMode="columnWidth"
        android:verticalSpacing="16dp" />

    <!-- Sag icerik paneli: secilen menu burada acilir -->
    <FrameLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="248dp"
        android:layout_marginTop="92dp"
        android:visibility="gone" />

    <!-- Solda sabit menu -->
    <LinearLayout
        android:id="@+id/side_bar"
        android:layout_width="222dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:layout_marginStart="26dp"
        android:layout_marginTop="96dp"
        android:orientation="vertical"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/side_home"
            style="@style/SideItem">

            <ImageView
                style="@style/SideIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_home" />

            <TextView
                style="@style/SideLabel"
                android:text="@string/home_title" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/side_recent"
            style="@style/SideItem">

            <ImageView
                style="@style/SideIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_history" />

            <TextView
                style="@style/SideLabel"
                android:text="@string/recent_title" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/side_search"
            style="@style/SideItem">

            <ImageView
                style="@style/SideIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_search" />

            <TextView
                style="@style/SideLabel"
                android:text="@string/search_title" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/side_discover"
            style="@style/SideItem">

            <ImageView
                style="@style/SideIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_discover" />

            <TextView
                style="@style/SideLabel"
                android:text="@string/discover" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/side_watchlist"
            style="@style/SideItem">

            <ImageView
                style="@style/SideIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_star" />

            <TextView
                style="@style/SideLabel"
                android:text="@string/watchlist" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/side_status"
            style="@style/SideItem">

            <ImageView
                style="@style/SideIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_check" />

            <TextView
                style="@style/SideLabel"
                android:text="@string/status_title" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/side_url"
            style="@style/SideItem">

            <ImageView
                style="@style/SideIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_plus" />

            <TextView
                style="@style/SideLabel"
                android:text="@string/custom_url" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/side_refresh"
            style="@style/SideItem">

            <ImageView
                android:id="@+id/side_refresh_glyph"
                style="@style/SideIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_refresh" />

            <TextView
                style="@style/SideLabel"
                android:text="@string/refresh_list" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/side_settings"
            style="@style/SideItem">

            <ImageView
                style="@style/SideIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_settings" />

            <TextView
                style="@style/SideLabel"
                android:text="@string/settings" />
        </LinearLayout>
    </LinearLayout>

    <!-- Sabit baslik: opak bant + altinda yumusak gecis -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FA0A0F16"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="38dp"
            android:paddingTop="20dp"
            android:paddingRight="38dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand_first"
                android:textColor="@color/accent"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:letterSpacing="0.16"
                android:text="@string/brand_second"
                android:textColor="@color/text"
                android:textSize="23sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <View
                android:id="@+id/status_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/status_dot" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:textColor="@color/text"
                android:textSize="23sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:background="@drawable/header_fade" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/hint_scrim"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="26dp"
        android:paddingBottom="13dp">

        <TextView
            style="@style/KeyCap"
            android:text="@string/key_ok" />

        <TextView
            style="@style/KeyLabel"
            android:text="@string/key_ok_action" />

        <TextView
            style="@style/KeyCap"
            android:text="@string/key_menu" />

        <TextView
            style="@style/KeyLabel"
            android:text="@string/key_menu_action" />

        <TextView
            style="@style/KeyCap"
            android:text="@string/key_back" />

        <TextView
            style="@style/KeyLabel"
            android:text="@string/key_back_action" />
    </LinearLayout>

</FrameLayout>
