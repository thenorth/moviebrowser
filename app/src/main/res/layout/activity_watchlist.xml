<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tv">

    <GridView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:drawSelectorOnTop="false"
        android:focusable="true"
        android:horizontalSpacing="14dp"
        android:listSelector="@android:color/transparent"
        android:numColumns="4"
        android:paddingLeft="38dp"
        android:paddingTop="92dp"
        android:paddingRight="38dp"
        android:paddingBottom="80dp"
        android:scrollbars="none"
        android:stretchMode="columnWidth"
        android:verticalSpacing="16dp" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:paddingLeft="60dp"
        android:paddingRight="60dp"
        android:text="@string/watch_empty"
        android:textColor="@color/text_dim"
        android:textSize="15sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/header_fade"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="38dp"
        android:paddingTop="16dp"
        android:paddingRight="38dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/watchlist"
            android:textColor="@color/text"
            android:textSize="23sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/hint_scrim"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="22dp"
        android:paddingBottom="10dp">

        <TextView
            style="@style/KeyCap"
            android:text="@string/key_ok" />

        <TextView
            style="@style/KeyLabel"
            android:text="@string/key_ok_action" />

        <TextView
            style="@style/KeyCap"
            android:text="@string/key_hold" />

        <TextView
            style="@style/KeyLabel"
            android:text="@string/key_hold_remove" />

        <TextView
            style="@style/KeyCap"
            android:text="@string/key_left" />

        <TextView
            style="@style/KeyLabel"
            android:text="@string/key_left_menu" />

        <TextView
            style="@style/KeyCap"
            android:text="@string/key_back" />

        <TextView
            style="@style/KeyLabel"
            android:text="@string/key_back_action" />
    </LinearLayout>

</FrameLayout>
